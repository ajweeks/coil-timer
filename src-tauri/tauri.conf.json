{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Coil",
  "version": "../package.json",
  "identifier": "com.ajweeks.coil",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop-frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coil",
        "width": 320,
        "height": 320,
        "minWidth": 140,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Distraction-free visual timer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
