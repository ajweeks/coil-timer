{
  "name": "coil-timer",
  "type": "module",
  "version": "1.0.0",
  "description": "distraction-free visual timer",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "png:social-preview": "rsvg-convert public/social-preview.svg -o public/social-preview.png -w1200 -h630",
    "png:touch-icon": "rsvg-convert public/icon-192.svg -o public/apple-touch-icon.png -a -w180",
    "png:app-icons": "sed 's/ filter=\"url(#shadow)\"//' public/icon-any-192.svg | rsvg-convert -o public/icon-any-512.png -w512 -h512 && rsvg-convert public/icon-192.svg -o public/icon-maskable-512.png -w512 -h512",
    "png": "npm run png:touch-icon && npm run png:social-preview && npm run png:app-icons",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@thi.ng/math": "^5.15.17",
    "@thi.ng/vectors": "^8.7.0",
    "clsx": "^2.1.1",
    "fast-deep-equal": "^3.1.3",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
